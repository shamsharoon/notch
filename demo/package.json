{
  "name": "notch-mixer-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A looping faux-UI demo of Notch's per-app volume Mixer, built with Stageshow.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "film": "node scripts/film.mjs http://127.0.0.1:5173/ --every 500 --count 32 --gate --out shots/loop.png",
    "film:phone": "node scripts/film.mjs http://127.0.0.1:5173/ --width 390 --every 500 --count 32 --gate --out shots/loop-390.png"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "~1.48.2",
    "postcss": "^8.5.6",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
